# Copy this file to .env. Shell variables still take precedence.
ARTICLE_TO_KINDLE_TOKEN=replace-with-a-long-random-token
ARTICLE_TO_KINDLE_ALLOWED_ORIGIN=chrome-extension://replace-with-extension-id
KINDLE_EMAIL=your-kindle-address@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=app-password
SMTP_FROM=your-email@example.com
