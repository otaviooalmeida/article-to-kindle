# Copy this file to .env. Shell variables still take precedence.
ARTICLE_TO_KINDLE_TOKEN=replace-with-a-long-random-token
ARTICLE_TO_KINDLE_ALLOWED_ORIGIN=chrome-extension://replace-with-extension-id
# AI mode forwards only to the remote Ollama loopback service through OpenSSH.
# Install your SSH public key on the remote account; never put its password here.
ARTICLE_TO_KINDLE_AI_SSH_TARGET=agrisat@10.230.102.83
ARTICLE_TO_KINDLE_AI_OLLAMA_URL=http://127.0.0.1:11435
ARTICLE_TO_KINDLE_AI_MODEL=qwen2.5:3b
# Optional default recipient for CLI --send; the extension asks for this in its Send panel.
KINDLE_EMAIL=your-kindle-address@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=articletokindle@gmail.com
SMTP_PASSWORD=app-password
SMTP_FROM=articletokindle@gmail.com
